VITE_API_BASE_URL=http://localhost:8080
VITE_COGNITO_AUTHORITY=http://localhost:4566/<COGNITO_USER_POOL_ID>
VITE_COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>
VITE_COGNITO_CLIENT_ID=<COGNITO_CLIENT_ID>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
VITE_COGNITO_ENDPOINT=/cognito-local
# Habilita form de cadastro/login direto por email+senha (sem Hosted UI) — só pra dev local
VITE_ENABLE_DIRECT_SIGNUP=true
